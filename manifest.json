{
  "manifest_version": 3,
  "name": "SelStats",
  "version": "1.3.0",
  "description": "Select numbers on any page to see Count, Sum, Avg, Median, Min and Max in a tiny status pill. Alt/Option-click (or Alt+double-click) a table cell for column stats.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "parser.js",
        "column.js",
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}